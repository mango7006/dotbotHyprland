{
  "layer": "top",
  "position": "top",
  "mode": "dock",
  "exclusive": true,
  "gtk-layer-shell": true,
  "height": 35,
  "modules-left": [
    // There are some optional modules that I do not need, enable and disable at will, they are all correctly styled
    // Please make sure you also have the required scripts in ~/.config/waybar/scripts/
    "clock",
    "clock#date",
    "custom/keyboardHypr",
    "custom/wireguard",
    "bluetooth",
    // Change the weather provider from Netherlands to International if needed
    // "custom/wttrNL",
    // "custom/wttrINT",
    // "custom/uptime",
    // "custom/notification",
    // "custom/wrk",
    // "hyprland/workspaces",
    "tray",
  ],
  "modules-center": [
    "mpris"
  ],
  "modules-right": [
    "pulseaudio",
    "network",
    "custom/mem",
    // "temperature",
    "cpu",
    "battery"
  ],
  "clock": {
    "format": "<span color='#d65d0e'>clk</span> {:%R}",
    "tooltip-format": "{:%R:%S}",
    "interval": 1
  },
  "clock#date": {
    "format": "<span color='#d65d0e'>dat</span> {:%d/%b}",
    "tooltip-format": "{:%A %d %B %Y week %g}",
    "format-alt": "<span color='#d65d0e'>dat</span> {:%d/%m/%Y}",
    "interval": 20
  },
  "custom/keyboardHypr": {
    "interval": 1,
    "exec": "~/.config/waybar/scripts/kbd-hypr.sh check",
    "format": "<span color='#d65d0e'>kbd</span> {text}",
    "on-click": "~/.config/waybar/scripts/kbd-hypr.sh next",
    "tooltip": false
  },
  "bluetooth": {
    "format": "<span color='#d65d0e'>blu</span> {status}",
    "tooltip-format": "{device_alias}, {device_battery_percentage}%",
    "on-click": "kitty --class bluetui -e bluetui",
    "on-click-right": "bluetooth toggle"
  },
  "custom/wttrNL": {
    "exec": "~/.config/waybar/scripts/weather-buienradar.sh",
    "format": "<span color='#d65d0e'>wtr</span> {text}",
    "tooltip": false,
    "on-click": "firefox --new-tab https://www.buienradar.nl/",
    "interval": 20,
  },
  "custom/wttrINT": {
    "exec": "curl -s \"wttr.in/?format=%t%c\" | sed 's/+//g; s/C/C /g; s/ //g'",
    "tooltip": false,
    "format": "<span color='#d65d0e'>wtr</span> {text}",
    "on-click": "firefox --new-tab https://www.accuweather.com/en/",
    "interval": 120
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
     "notification": "<span foreground='red'><sup>⬤ </sup></span>",
      "none": " ",
      "dnd-notification": "<span foreground='red'><sup>⬤ </sup></span>",
      "dnd-none": " "
   },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "sleep 0.1 && swaync-client -t -sw",
    "on-click-right": "sleep 0.1 && swaync-client -d -sw",
    "escape": true
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10
  },
  "mpris": {
    "format": "{artist} / {title}",
    "interval": 1,
    "max-length": 80,
    "on-click": "playerctl play-pause",
    "ignored-players": [
      "firefox"
    ]
  },
  "pulseaudio": {
    "format": "<span color='#d65d0e'>vol</span> {volume}",
    "tooltip": true,
    "format-muted": "<span color='#d65d0e'>vol</span> muted",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click": "kitty --class wiremix -e wiremix",
    "on-scroll-up": "wpctl set-volume -l 1.4 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume -l 1.4 @DEFAULT_AUDIO_SINK@ 5%-",
    "scroll-step": 5
  },
  "network": {
    "format": "<span color='#d65d0e'>net</span> {ifname}",
    "format-wifi": "<span color='#d65d0e'>net</span> {essid}",
    "format-ethernet": "<span color='#d65d0e'>net</span> {ipaddr}/{cidr} ",
    "tooltip-format": "{cidr} - {ifname} via {ipaddr}",
    "format-disconnected": "<span color='#d65d0e'>net</span> Disconnected",
    "on-click": "kitty --class impala -e impala",
  },
  "custom/wireguard": {
    "exec": "~/.config/waybar/scripts/wireguard-check.sh",
    "format": "<span color='#d65d0e'>vpn</span> {text}",
    "tooltip": false,
    "interval": 1,
  },
  "custom/mem": {
    "exec": "free -m | awk 'NR==2 { print $3 \" MiB\" }'",
    "format": "<span color='#d65d0e'>mem</span> {text}",
    "on-click": "kitty --class btop -e btop",
    "tooltip": false,
    "interval": 1,
  },
  "temperature": {
    "interval": 4,
    "thermal-zone": 7,
    "critical-threshold": 75,
    "format-critical": "<span color='#d65d0e'>tmp</span> <span color='#ff0000'>{temperatureC}°C</span>",
    "format": "<span color='#d65d0e'>tmp</span> {temperatureC}°C"
},
  "cpu": {
    "format": "<span color='#d65d0e'>cpu</span> {usage}%",
    "on-click": "kitty --class btop -e btop",
    "interval": 1,
    "states": {
      "high": 65,
      "medium": 30,
      "low": 0
    }
  },
  "battery": {
    "interval": 1,
    "format": "<span color='#d65d0e'>bat</span> {capacity}%",
    "format-charging": "<span color='#d65d0e'>bat</span> {capacity}%",
    "format-plugged": "<span color='#d65d0e'>bat</span> {capacity}%",
    "tooltip": false,
    "states": {
      "full": 100,
      "almost": 85,
      "white0": 84,
      "white1": 31,
      "warning": 30,
      "critical": 15
    }
  }
}
